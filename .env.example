# Vortex runs in historical-only mode by default.
VORTEX_LIVE_ENABLED=false

# OpenF1 live access requires personal sponsor credentials.
OPENF1_USERNAME=
OPENF1_PASSWORD=

# Optional provider overrides.
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1
OPENF1_REST_URL=https://api.openf1.org/v1
OPENF1_TOKEN_URL=https://api.openf1.org/token
OPENF1_MQTT_HOST=mqtt.openf1.org
OPENF1_MQTT_PORT=8883

# Optional behavior tuning.
VORTEX_HTTP_TIMEOUT_MS=5000
VORTEX_PUBLISH_CADENCE_MS=500
VORTEX_RECONNECT_MAX_MS=30000
VORTEX_REFERENCE_CACHE_MAX_ENTRIES=256
VORTEX_REFERENCE_CACHE_FAILURE_RETRY_MS=1000
VORTEX_SCHEDULE_TTL_MS=900000
VORTEX_STANDINGS_TTL_MS=300000
VORTEX_CURRENT_RESULTS_TTL_MS=86400000
